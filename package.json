{
  "name": "recipe-saver-backend",
  "version": "1.6.0",
  "main": "src/index.js",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test test/*.test.js",
    "test:integration": "node --test test/integration/*.test.js",
    "test:smoke": "node smoke-test.js",
    "offers:import": "node scripts/import-market-offers.js",
    "check": "node --test test/*.test.js && find src -name '*.js' -print0 | xargs -0 -n1 node --check"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.0",
    "@supabase/supabase-js": "^2.45.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "multer": "^2.0.2",
    "openai": "^4.56.0"
  }
}
